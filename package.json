{
  "name": "lor-browser",
  "version": "0.1.0",
  "description": "Lor - Modern Liquid Glass Monochrome Browser for macOS",
  "main": "dist-electron/main.js",
  "author": "Tyler Tan",
  "license": "MIT",
  "homepage": "https://tylertzm.github.io/lor-browser/",
  "repository": {
    "type": "git",
    "url": "https://github.com/tylertzm/lor-browser.git"
  },
  "bugs": {
    "url": "https://github.com/tylertzm/lor-browser/issues"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:all": "node scripts/dev.js",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "electron .",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.tyler.lor",
    "productName": "Lor",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "Lor Installer"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  }
}
